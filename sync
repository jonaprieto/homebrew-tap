#!/usr/bin/env bash
# Copy each formula and cask named in ./sources from its tool repo's default branch.
# Locally it writes files; with SYNC_COMMIT=1 (CI) it commits changed files through the
# GitHub contents API, so the commits are signed by GitHub and show as Verified.
set -euo pipefail
cd "$(dirname "$0")"
repo=${GITHUB_REPOSITORY:-jonaprieto/homebrew-tap}
changed=0

while read -r dest src path; do
  case "$dest" in ''|'#'*) continue ;; esac
  if ! new=$(gh api "repos/$src/contents/$path" -H "Accept: application/vnd.github.raw" 2>/dev/null); then
    echo "skip $dest: $src has no $path yet"
    continue
  fi
  if [ -f "$dest" ] && [ "$new" = "$(cat "$dest")" ]; then
    continue
  fi
  echo "update $dest from $src"
  changed=1
  if [ "${SYNC_COMMIT:-0}" = 1 ]; then
    sha=$(gh api "repos/$repo/contents/$dest" --jq .sha 2>/dev/null || true)
    gh api -X PUT "repos/$repo/contents/$dest" \
      -f message="Sync $dest from $src" \
      -f content="$(printf '%s\n' "$new" | base64 | tr -d '\n')" \
      ${sha:+-f sha="$sha"} >/dev/null
  else
    mkdir -p "$(dirname "$dest")"
    printf '%s\n' "$new" > "$dest"
  fi
done < sources

if [ "$changed" = 0 ]; then
  echo "everything up to date"
elif [ "${SYNC_COMMIT:-0}" = 1 ]; then
  # commits made with the workflow token do not trigger CI on their own
  gh workflow run ci.yml --repo "$repo"
fi
